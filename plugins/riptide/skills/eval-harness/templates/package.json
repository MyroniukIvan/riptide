{
  "name": "evals",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Eval harness for this project's AI surfaces: static gate, deterministic scoring, LLM judge, trace assertions.",
  "scripts": {
    "gate": "node static-gate.mjs",
    "eval": "vitest run",
    "eval:one": "vitest run",
    "repeat": "tsx src/stats.ts repeat",
    "bench": "tsx src/stats.ts bench",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
