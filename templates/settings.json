{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "permissions": {
    "deny": [
      "Read(node_modules/**)",
      "Read(dist/**)",
      "Read(build/**)",
      "Read(out/**)",
      "Read(.next/**)",
      "Read(.nuxt/**)",
      "Read(.svelte-kit/**)",
      "Read(.turbo/**)",
      "Read(.parcel-cache/**)",
      "Read(storybook-static/**)",
      "Read(coverage/**)",
      "Read(playwright-report/**)",
      "Read(**/*.min.js)",
      "Read(**/*.map)",
      "Read(**/*.tsbuildinfo)",
      "Read(pnpm-lock.yaml)",
      "Read(package-lock.json)",
      "Read(yarn.lock)",
      "Read(bun.lock)",
      "Read(bun.lockb)",

      "Read(.env)",
      "Read(.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa*)",
      "Read(.claude/cache/**)"
    ],

    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git merge-base:*)",

      "Bash(npm run test:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm exec tsc --noEmit:*)",
      "Bash(pnpm exec vitest run:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(npx vitest run:*)"
    ]
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.sh",
            "timeout": 10,
            "statusMessage": "Checking for destructive commands"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ship-gate.sh",
            "if": "Bash(gh pr create*)",
            "timeout": 15,
            "statusMessage": "Checking the pre-PR gate"
          }
        ]
      }
    ]
  },

  "includeCoAuthoredBy": true,
  "cleanupPeriodDays": 30
}
